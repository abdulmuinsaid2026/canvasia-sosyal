{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=canvasia_social;Username=postgres"
  },
  "DataProtection": {
    "KeysPath": "./keys"
  },
  "Security": {
    "UseHttpsRedirection": true
  },
  "Canvasia": {
    "BaseUrl": "",
    "ApiKey": "",
    "ProductsPageSize": 100,
    "SyncCron": "0 */6 * * *",
    "RequestTimeoutSeconds": 30
  },
  "OpenRouter": {
    "BaseUrl": "https://openrouter.ai/api/v1/",
    "ApiKey": "",
    "Model": "openai/gpt-4o-mini",
    "RequestTimeoutSeconds": 120
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
