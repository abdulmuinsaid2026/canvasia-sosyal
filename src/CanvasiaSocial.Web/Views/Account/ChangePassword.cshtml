@model CanvasiaSocial.Web.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Parola değiştir";
}

<section class="form-card narrow-card">
    <p class="eyebrow">HESAP GÜVENLİĞİ</p>
    <h1>Parolanızı değiştirin</h1>
    <p>İlk kurulum parolasını kullandıysanız giriş yaptıktan sonra burada değiştirin.</p>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="notice success" role="status">@successMessage</div>
    }

    <form asp-action="ChangePassword" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="field">
            <label asp-for="CurrentPassword"></label>
            <input asp-for="CurrentPassword" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="validation-summary"></span>
        </div>
        <div class="field">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="validation-summary"></span>
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="validation-summary"></span>
        </div>
        <button type="submit" class="primary-button">Parolayı değiştir</button>
    </form>
</section>
