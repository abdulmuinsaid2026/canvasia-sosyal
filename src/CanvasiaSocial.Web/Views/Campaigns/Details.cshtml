@model CanvasiaSocial.Application.Campaigns.CampaignDetails
@{ ViewData["Title"] = Model.Name; }
<section class="page-heading split-heading"><div><p class="eyebrow">@Model.Platform · @Model.Mode</p><h1>@Model.Name</h1><p>Durum: <strong>@Model.Status</strong> · @Model.CompletedItems/@Model.TotalItems hazır · @Model.FailedItems başarısız</p></div><a class="secondary-button" asp-action="Details" asp-route-id="@Model.Id">İlerlemeyi yenile</a></section>
<div class="button-row campaign-actions">
<form asp-action="Pause" asp-route-id="@Model.Id" method="post"><button class="secondary-button">Duraklat</button></form>
<form asp-action="Resume" asp-route-id="@Model.Id" method="post"><button class="secondary-button">Devam ettir</button></form>
<form asp-action="Approve" asp-route-id="@Model.Id" method="post"><button class="secondary-button">Tümünü onayla</button></form>
<form asp-action="Schedule" asp-route-id="@Model.Id" method="post"><button class="primary-button compact">Takvime aktar</button></form>
<form asp-action="Cancel" asp-route-id="@Model.Id" method="post"><button class="danger-button">İptal et</button></form>
</div>
<div class="campaign-items">@foreach (var item in Model.Items) { <article class="content-card"><div><strong>@item.ProductTitle</strong><span class="status-pill">@item.Status</span></div>@if (!string.IsNullOrWhiteSpace(item.Caption)) { <p>@item.Caption</p> }@if (!string.IsNullOrWhiteSpace(item.Error)) { <p class="error-text">@item.Error</p><form asp-action="Retry" asp-route-itemId="@item.Id" asp-route-campaignId="@Model.Id" method="post"><button class="secondary-button">Tekrar dene</button></form> }@if (item.ScheduledAtUtc.HasValue) { <small>@TimeZoneInfo.ConvertTimeBySystemTimeZoneId(item.ScheduledAtUtc.Value, Model.TimeZoneId).ToString("dd.MM.yyyy HH:mm")</small> }</article> }</div>
