@using CanvasiaSocial.Application.Products
@using CanvasiaSocial.Domain.Enums
@model PagedResult<ProductListItem>
@{
    ViewData["Title"] = "Ürünler";
    var filter = (ProductSearch)ViewBag.Filter;
    var preparedFrom = (DateTime?)ViewBag.PreparedFrom;
    var preparedTo = (DateTime?)ViewBag.PreparedTo;
    var publishedFrom = (DateTime?)ViewBag.PublishedFrom;
    var publishedTo = (DateTime?)ViewBag.PublishedTo;
    var zone = TimeZoneInfo.FindSystemTimeZoneById("Europe/Istanbul");
    var activeFilterCount = new object?[] { filter.Search, filter.Category, filter.InStock, filter.IsDiscounted,
        filter.Platform, filter.HasAiContent, filter.ContentStatus, filter.IsPublished,
        preparedFrom, preparedTo, publishedFrom, publishedTo }.Count(x => x is not null && x.ToString() != "");
}

<section class="page-heading split-heading">
    <div>
        <p class="eyebrow">CANVASIA ÜRÜN KATALOĞU</p>
        <h1>Ürünler</h1>
        <p>Ürünlerin yapay zekâ içerik hazırlığını ve platform yayın durumunu tek ekrandan izleyin.</p>
    </div>
    <strong class="result-count">@Model.TotalItems.ToString("N0") ürün</strong>
</section>

<details class="advanced-filter" open>
    <summary><span>Ayrıntılı filtreler</span><small>@(activeFilterCount == 0 ? "Filtre uygulanmadı" : $"{activeFilterCount} filtre etkin")</small></summary>
    <form method="get" class="product-filter-grid">
        <label class="filter-wide">Arama<input name="search" value="@filter.Search" placeholder="Ürün adı veya bağlantı kısa adı" /></label>
        <label>Kategori<input name="category" value="@filter.Category" placeholder="Kategori adı" /></label>
        <label>Platform
            <select name="platform"><option value="">Tüm platformlar</option>@foreach (var platform in Enum.GetValues<Platform>()) { <option value="@platform" selected="@(filter.Platform == platform)">@platform</option> }</select>
        </label>
        <label>AI içerik
            <select name="hasAiContent"><option value="">Tümü</option><option value="true" selected="@(filter.HasAiContent is true)">AI içeriği hazırlanan</option><option value="false" selected="@(filter.HasAiContent is false)">Henüz hazırlanmayan</option></select>
        </label>
        <label>İçerik durumu
            <select name="contentStatus"><option value="">Tüm durumlar</option>@foreach (var status in Enum.GetValues<ContentStatus>()) { <option value="@status" selected="@(filter.ContentStatus == status)">@status.Turkish()</option> }</select>
        </label>
        <label>Yayın durumu
            <select name="isPublished"><option value="">Tümü</option><option value="true" selected="@(filter.IsPublished is true)">Yayımlanan</option><option value="false" selected="@(filter.IsPublished is false)">Henüz yayımlanmayan</option></select>
        </label>
        <label>Stok
            <select name="inStock"><option value="">Tümü</option><option value="true" selected="@(filter.InStock is true)">Stokta</option><option value="false" selected="@(filter.InStock is false)">Stokta yok</option></select>
        </label>
        <label>İndirim
            <select name="isDiscounted"><option value="">Tümü</option><option value="true" selected="@(filter.IsDiscounted is true)">İndirimli</option><option value="false" selected="@(filter.IsDiscounted is false)">İndirimsiz</option></select>
        </label>
        <fieldset class="date-filter"><legend>AI hazırlanma tarihi</legend><label>Başlangıç<input type="date" name="preparedFrom" value="@preparedFrom?.ToString("yyyy-MM-dd")" /></label><label>Bitiş<input type="date" name="preparedTo" value="@preparedTo?.ToString("yyyy-MM-dd")" /></label></fieldset>
        <fieldset class="date-filter"><legend>Yayın tarihi</legend><label>Başlangıç<input type="date" name="publishedFrom" value="@publishedFrom?.ToString("yyyy-MM-dd")" /></label><label>Bitiş<input type="date" name="publishedTo" value="@publishedTo?.ToString("yyyy-MM-dd")" /></label></fieldset>
        <label>Sıralama
            <select name="sort">@foreach (var sort in Enum.GetValues<ProductSort>()) { <option value="@sort" selected="@(filter.Sort == sort)">@sort.Turkish()</option> }</select>
        </label>
        <label>Sayfadaki ürün
            <select name="pageSize">@foreach (var size in new[] { 12, 24, 48, 100 }) { <option value="@size" selected="@(filter.PageSize == size)">@size</option> }</select>
        </label>
        <div class="filter-actions"><button class="primary-button compact" type="submit">Filtreleri uygula</button><a class="secondary-button" asp-action="Index">Filtreleri temizle</a></div>
    </form>
</details>

@if (Model.Items.Count == 0)
{
    <section class="empty-state"><h2>Filtrelere uygun ürün bulunamadı</h2><p>Filtrelerden birini kaldırın veya ürün kataloğunu yeniden eşitleyin.</p><a class="secondary-button inline-button" asp-action="Index">Tüm ürünleri göster</a></section>
}
else
{
    <form asp-controller="BulkPrepare" asp-action="Index" method="post" id="bulk-form">
    <div class="bulk-toolbar"><button type="button" class="secondary-button" id="select-page">Sayfadakileri seç</button><button type="button" class="text-button" id="clear-selection">Seçimi temizle</button><strong><span id="selected-count">0</span> ürün seçildi</strong><button type="submit" class="primary-button compact">Toplu içerik hazırla</button></div>
    <section class="product-grid" aria-label="Ürün listesi">
        @foreach (var product in Model.Items)
        {
            <article class="product-card">
                <label class="product-select"><input type="checkbox" name="productIds" value="@product.Id" /> Seç</label>
                <a class="product-image" asp-action="Details" asp-route-id="@product.Id">
                    @if (!string.IsNullOrWhiteSpace(product.PrimaryImageUrl)) { <img src="@product.PrimaryImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" /> }
                    else { <span>Görsel yok</span> }
                </a>
                <div class="product-body">
                    <p class="product-category">@(product.CategoryName ?? "Kategorisiz")</p>
                    <h2><a asp-action="Details" asp-route-id="@product.Id">@product.Title</a></h2>
                    <div class="product-meta">
                        <strong>@product.Price.ToString("N2") TL</strong>
                        <span class="status-pill @(product.InStock ? "success" : "muted")">@(product.InStock ? "Stokta" : "Stokta yok")</span>
                        @if (product.IsDiscounted) { <span class="status-pill sale">İndirimli</span> }
                    </div>
                    <section class="platform-activities" aria-label="İçerik ve yayın durumu">
                    @if (product.PlatformActivities.Count == 0)
                    {
                        <div class="platform-empty"><strong>İçerik hazırlanmadı</strong><span>Henüz hiçbir platform için AI içeriği yok.</span></div>
                    }
                    @foreach (var activity in product.PlatformActivities)
                    {
                        var activityTime = activity.PublishedAtUtc ?? activity.ContentUpdatedAtUtc;
                        var localTime = activityTime.HasValue ? TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(activityTime.Value, DateTimeKind.Utc), zone) : (DateTime?)null;
                        <div class="platform-activity">
                            <div><strong>@activity.Platform</strong><span class="status-pill @(activity.IsPublished ? "success" : activity.LatestContentStatus == ContentStatus.Failed ? "sale" : "muted")">@(activity.IsPublished ? "Yayımlandı" : activity.LatestContentStatus?.Turkish() ?? "Hazırlanmadı")</span></div>
                            @if (activity.IsPublished)
                            {
                                <small>@localTime?.ToString("dd.MM.yyyy HH:mm") tarihinde yayımlandı</small>
                                @if (!string.IsNullOrWhiteSpace(activity.ExternalPostUrl)) { <a href="@activity.ExternalPostUrl" target="_blank" rel="noopener noreferrer">Gönderiyi aç</a> }
                            }
                            else
                            {
                                @if (!string.IsNullOrWhiteSpace(activity.ModelName)) { <small>AI modeli: @activity.ModelName</small> }
                                @if (localTime.HasValue) { <small>Son işlem: @localTime.Value.ToString("dd.MM.yyyy HH:mm")</small> }
                            }
                        </div>
                    }
                    </section>
                    <div class="card-actions">
                        <a asp-action="Details" asp-route-id="@product.Id">Ayrıntı</a>
                        @if (!string.IsNullOrWhiteSpace(product.ProductUrl)) { <a href="@product.ProductUrl" target="_blank" rel="noopener noreferrer">Canvasia'da aç</a> }
                    </div>
                </div>
            </article>
        }
    </section>
    </form>

    <nav class="pagination" aria-label="Ürün sayfaları">
        @if (Model.Page > 1)
        {
            <a asp-all-route-data="@RouteValues(Model.Page - 1, filter, preparedFrom, preparedTo, publishedFrom, publishedTo)">Önceki</a>
        }
        <span>Sayfa @Model.Page / @Model.TotalPages</span>
        @if (Model.Page < Model.TotalPages)
        {
            <a asp-all-route-data="@RouteValues(Model.Page + 1, filter, preparedFrom, preparedTo, publishedFrom, publishedTo)">Sonraki</a>
        }
    </nav>
}
<script>
(() => {
  if (window.matchMedia('(max-width: 560px)').matches) document.querySelector('.advanced-filter')?.removeAttribute('open');
  const boxes = [...document.querySelectorAll('input[name="productIds"]')];
  const count = document.getElementById('selected-count');
  const update = () => { if (count) count.textContent = boxes.filter(x => x.checked).length; };
  boxes.forEach(x => x.addEventListener('change', update));
  document.getElementById('select-page')?.addEventListener('click', () => { boxes.forEach(x => x.checked = true); update(); });
  document.getElementById('clear-selection')?.addEventListener('click', () => { boxes.forEach(x => x.checked = false); update(); });
})();
</script>

@functions {
    private static Dictionary<string, string> RouteValues(int page, ProductSearch filter, DateTime? preparedFrom,
        DateTime? preparedTo, DateTime? publishedFrom, DateTime? publishedTo) => new()
    {
        ["page"] = page.ToString(), ["pageSize"] = filter.PageSize.ToString(), ["search"] = filter.Search ?? "",
        ["category"] = filter.Category ?? "", ["inStock"] = filter.InStock?.ToString() ?? "",
        ["isDiscounted"] = filter.IsDiscounted?.ToString() ?? "", ["platform"] = filter.Platform?.ToString() ?? "",
        ["hasAiContent"] = filter.HasAiContent?.ToString() ?? "", ["contentStatus"] = filter.ContentStatus?.ToString() ?? "",
        ["isPublished"] = filter.IsPublished?.ToString() ?? "", ["preparedFrom"] = preparedFrom?.ToString("yyyy-MM-dd") ?? "",
        ["preparedTo"] = preparedTo?.ToString("yyyy-MM-dd") ?? "", ["publishedFrom"] = publishedFrom?.ToString("yyyy-MM-dd") ?? "",
        ["publishedTo"] = publishedTo?.ToString("yyyy-MM-dd") ?? "", ["sort"] = filter.Sort.ToString()
    };
}
