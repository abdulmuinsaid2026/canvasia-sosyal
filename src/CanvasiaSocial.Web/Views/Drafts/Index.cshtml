@model IReadOnlyList<CanvasiaSocial.Application.Ai.GeneratedContentView>
@{ ViewData["Title"] = "Taslaklar"; }
<section class="page-heading"><p class="eyebrow">ONAY AKIŞI</p><h1>Taslaklar</h1><p>Bekleyen içerikleri toplu onaylayın veya reddedin.</p></section>
<form asp-action="Review" method="post"><div class="bulk-toolbar"><button name="approve" value="true" class="primary-button compact">Seçilenleri onayla</button><button name="approve" value="false" class="danger-button">Seçilenleri reddet</button><button formaction="/Drafts/Schedule" class="secondary-button">Seçilenleri planla</button></div><div class="content-stack">@foreach (var item in Model) { <label class="content-card selectable"><input type="checkbox" name="contentIds" value="@item.Id" /><span><strong>@item.Platform · @item.Status</strong><p>@item.Caption</p></span></label> }</div></form>
