@model IReadOnlyList<CanvasiaSocial.Application.Ai.GeneratedContentView>
@{
    ViewData["Title"] = "Taslaklar";
}

<section class="page-heading">
    <p class="eyebrow">ONAY AKIŞI</p>
    <h1>Taslaklar</h1>
    <p>Bekleyen içerikleri toplu onaylayın veya reddedin.</p>
</section>

<form asp-action="Review" method="post" id="drafts-form">
    <div class="bulk-toolbar">
        <button type="button" class="secondary-button" id="select-all-drafts">Tümünü seç</button>
        <button type="button" class="text-button" id="clear-draft-selection">Seçimi temizle</button>
        <strong><span id="selected-draft-count">0</span> içerik seçildi</strong>
        <button name="approve" value="true" class="primary-button compact">Seçilenleri onayla</button>
        <button name="approve" value="false" class="danger-button">Seçilenleri reddet</button>
        <button formaction="/Drafts/Schedule" class="secondary-button">Seçilenleri planla</button>
    </div>
    <div class="content-stack">
        @foreach (var item in Model)
        {
            <label class="content-card selectable">
                <input type="checkbox" name="contentIds" value="@item.Id" />
                <span><strong>@item.Platform · @item.Status.Turkish()</strong><p>@item.Caption</p></span>
            </label>
        }
    </div>
</form>

<script>
    (() => {
        const form = document.getElementById('drafts-form');
        const boxes = [...form.querySelectorAll('input[name="contentIds"]')];
        const count = document.getElementById('selected-draft-count');
        const updateCount = () => count.textContent = boxes.filter(box => box.checked).length;

        boxes.forEach(box => box.addEventListener('change', updateCount));
        document.getElementById('select-all-drafts').addEventListener('click', () => {
            boxes.forEach(box => box.checked = true);
            updateCount();
        });
        document.getElementById('clear-draft-selection').addEventListener('click', () => {
            boxes.forEach(box => box.checked = false);
            updateCount();
        });
    })();
</script>
