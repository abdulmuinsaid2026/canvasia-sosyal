@using CanvasiaSocial.Domain.Enums
@model IReadOnlyList<CanvasiaSocial.Application.Campaigns.CalendarEntry>
@{ ViewData["Title"] = "Takvim"; var zone = TimeZoneInfo.FindSystemTimeZoneById("Europe/Istanbul"); }
<section class="page-heading"><p class="eyebrow">EUROPE/ISTANBUL</p><h1>İçerik takvimi</h1><p>Planlar UTC saklanır, burada İstanbul saatiyle gösterilir.</p></section>
<form method="get" class="filter-panel calendar-filter"><label>Görünüm<select name="view"><option value="day">Gün</option><option value="week">Hafta</option><option value="month" selected>Ay</option></select></label><label>Tarih<input type="date" name="date" value="@(((DateTime)ViewBag.Date).ToString("yyyy-MM-dd"))" /></label><label>Platform<select name="platform"><option value="">Tümü</option>@foreach (var p in Enum.GetValues<Platform>()) { <option value="@p">@p</option> }</select></label><label>Durum<select name="status"><option value="">Tümü</option>@foreach (var s in Enum.GetValues<ContentStatus>()) { <option value="@s">@s</option> }</select></label><button class="primary-button compact">Göster</button></form>
<div class="calendar-list">@foreach (var item in Model) { var local = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(item.ScheduledAtUtc, DateTimeKind.Utc), zone); <article class="calendar-card"><time><strong>@local.ToString("dd")</strong><span>@local.ToString("MMM HH:mm")</span></time><div><p class="eyebrow">@item.Platform · @item.Status</p><h2>@item.ProductTitle</h2><span>@item.CampaignName</span></div><form asp-action="Reschedule" asp-route-id="@item.ScheduledPostId" method="post"><input type="datetime-local" name="localTime" value="@local.ToString("yyyy-MM-ddTHH:mm")" /><button class="secondary-button">Değiştir</button></form><form asp-action="Cancel" asp-route-id="@item.ScheduledPostId" method="post"><button class="text-button">İptal</button></form></article> }</div>
