<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Canvasia Sosyal</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <img class="brand-logo" src="~/images/canvasia-logo.svg" alt="Canvasia" />
            <span>Sosyal</span>
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav class="main-nav" aria-label="Ana menü">
                <a asp-controller="Home" asp-action="Index">Genel bakış</a>
                <a asp-controller="Products" asp-action="Index">Ürünler</a>
                <a asp-controller="Campaigns" asp-action="Index">Kampanyalar</a>
                <a asp-controller="Drafts" asp-action="Index">Taslaklar</a>
                <a asp-controller="Calendar" asp-action="Index">Takvim</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="CanvasiaSettings" asp-action="Index">Canvasia</a>
                    <a asp-controller="SocialAccounts" asp-action="Index">Sosyal hesaplar</a>
                }
            </nav>
            <div class="user-menu">
                <span>@User.Identity.Name</span>
                <a class="text-button" asp-controller="Account" asp-action="ChangePassword">Parola değiştir</a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="text-button">Çıkış</button>
                </form>
            </div>
        }
    </header>
    <main class="container">
        @RenderBody()
    </main>
</body>
</html>
