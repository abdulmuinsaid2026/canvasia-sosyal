POSTGRES_DB=canvasia_social
POSTGRES_USER=canvasia
POSTGRES_PASSWORD=change_this_database_password
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeThis_AdminPassword_123!
LOGIN_RATE_LIMIT_PER_MINUTE=10
GENERAL_WORKER_COUNT=4
CANVASIA_API_BASE_URL=https://www.canvasia.com.tr
CANVASIA_API_KEY=replace_with_canvasia_social_api_key
CANVASIA_PRODUCTS_PAGE_SIZE=100
CANVASIA_SYNC_CRON=0 */6 * * *
CANVASIA_REQUEST_TIMEOUT_SECONDS=30
CANVASIA_SOCIAL_PORT=8080
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace_with_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_REQUEST_TIMEOUT_SECONDS=120
CANVASIA_BATCH_MAX_PRODUCTS=100
CANVASIA_AI_BATCH_CONCURRENCY=1
CANVASIA_DEFAULT_POST_INTERVAL_MINUTES=60
CANVASIA_INSTAGRAM_DAILY_LIMIT=10
CANVASIA_FACEBOOK_DAILY_LIMIT=10
CANVASIA_TIKTOK_DAILY_LIMIT=5
CANVASIA_PINTEREST_DAILY_LIMIT=20
CANVASIA_REQUIRE_APPROVAL=true
DEFAULT_TIME_ZONE=Europe/Istanbul
AUTO_PUBLISH_ENABLED=false
PUBLISH_MAX_RETRY_COUNT=3
DATA_PROTECTION_KEYS_PATH=/var/lib/canvasia-social/keys
RUN_MIGRATIONS=true
DATA_PROTECTION_STORE=file
TRUST_FORWARDED_HEADERS=false
CANVASIA_ALLOWED_IMAGE_HOSTS=canvasia.com.tr
SOCIAL_IMAGE_MAX_BYTES=10485760
SOCIAL_IMAGE_TIMEOUT_SECONDS=20
INSTAGRAM_ENABLED=false
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8080/SocialAccounts/Instagram/Callback
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish
INSTAGRAM_API_BASE_URL=https://graph.instagram.com/v25.0/
FACEBOOK_ENABLED=false
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8080/SocialAccounts/Facebook/Callback
FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts
FACEBOOK_API_BASE_URL=https://graph.facebook.com/v25.0/
TIKTOK_ENABLED=false
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8080/SocialAccounts/TikTok/Callback
TIKTOK_SCOPES=user.info.basic,video.publish
TIKTOK_API_BASE_URL=https://open.tiktokapis.com/v2/
PINTEREST_ENABLED=false
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:8080/SocialAccounts/Pinterest/Callback
PINTEREST_SCOPES=user_accounts:read,boards:read,pins:read,pins:write
PINTEREST_API_BASE_URL=https://api.pinterest.com/v5/
